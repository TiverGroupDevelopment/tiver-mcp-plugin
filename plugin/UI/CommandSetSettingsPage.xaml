<Page x:Class="revit_mcp_plugin.UI.CommandSetSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:revit_mcp_plugin.UI"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Main Content Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <!-- Command Set List -->
            <Border Grid.Column="0" BorderBrush="#e0e0e0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Available Command Sets" Padding="10,8"
                               Background="#f0f0f0" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1" x:Name="CommandSetListBox"
                             SelectionChanged="CommandSetListBox_SelectionChanged"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="#666"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="#666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <!-- Ширину списка наборов можно менять перетаскиванием -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
            <!-- Command Set Features List -->
            <Border Grid.Column="2" BorderBrush="#e0e0e0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Background="#f0f0f0">
                        <!-- Category: команды по раскрывающимся категориям или одним списком -->
                        <CheckBox x:Name="GroupByCategoryCheckBox" DockPanel.Dock="Right" Content="Category"
                                  IsChecked="True" VerticalAlignment="Center" Margin="10,0,10,0"
                                  ToolTip="Разложить команды по категориям (раскрывающиеся списки) или показать одним списком"
                                  Checked="GroupByCategoryCheckBox_Changed" Unchecked="GroupByCategoryCheckBox_Changed"/>
                        <!-- Parameters: показать или скрыть столбец Parameters -->
                        <CheckBox x:Name="ShowParametersCheckBox" DockPanel.Dock="Right" Content="Parameters"
                                  IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                  ToolTip="Показать или скрыть столбец Parameters"
                                  Checked="ShowParametersCheckBox_Changed" Unchecked="ShowParametersCheckBox_Changed"/>
                        <TextBlock x:Name="FeaturesHeaderTextBlock"
                                   Text="Command List" Padding="10,8" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ListView Grid.Row="1" x:Name="FeaturesListView" BorderThickness="0">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="False" Margin="0,1,0,1" Padding="0,2,0,2">
                                                        <Expander.Header>
                                                            <TextBlock>
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <Run Text=" (" Foreground="#666"/><Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="#666"/><Run Text=")" Foreground="#666"/>
                                                            </TextBlock>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView x:Name="FeaturesGridView">
                                <GridViewColumn Header="Enable" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="230"
                                               DisplayMemberBinding="{Binding CommandName}"/>
                                <!-- Входные параметры команды по схеме инструмента сервера -->
                                <GridViewColumn x:Name="ParametersColumn" Header="Parameters" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ParametersText}" TextWrapping="Wrap"
                                                       ToolTip="{Binding ParametersText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Description" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <!-- Displayed when no command set is selected -->
                    <TextBlock Grid.Row="1" x:Name="NoSelectionTextBlock"
                              Text="Please select a command set from the left to view its commands"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="#999" FontSize="14" TextWrapping="Wrap"
                              Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Open Logs" Width="90" Height="30" Margin="0,0,10,0" Click="OpenLogsButton_Click"
                    ToolTip="Папка логов плагина: загрузка команд, порт, ошибки"/>
            <Button Content="Select All" Width="80" Height="30" Margin="0,0,10,0" Click="SelectAllButton_Click"
                    ToolTip="Включить все команды открытого набора"/>
            <Button Content="Select Set" Width="80" Height="30" Margin="0,0,10,0" Click="SelectSetButton_Click"
                    ToolTip="Включить все команды открытого набора и выключить команды остальных наборов"/>
            <Button Content="Deselect All" Width="80" Height="30" Margin="0,0,10,0" Click="UnselectAllButton_Click"
                    ToolTip="Выключить все команды открытого набора"/>
            <Button Content="Save" Width="80" Height="30" Background="#0078D7" Foreground="White"
                   Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
